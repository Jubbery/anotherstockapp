# Atlas environment variables.
#
# NAMES ONLY -- this file must never contain a value, not even a paper one
# (R-16.3.b). Copy to .env for local development and fill from your own paper
# account. .env is gitignored; keep it that way.
#
# Where each secret is permitted to exist: MASTER_SPEC §16.3.
# Full reference with types, units, and defaults: MASTER_SPEC Appendix A.

# ---------------------------------------------------------------- required
# R-11.1.a: explicitly 'paper' or 'live'. No default. Missing value crashes.
ALPACA_ENV=
# 0-8. Live trading requires >= 8 (R-11.1.c).
ATLAS_PHASE=
# Required only when ALPACA_ENV=live. Must be exactly: yes-i-mean-it
ATLAS_LIVE_CONFIRMED=

# ---------------------------------------------------------------- broker
ALPACA_PAPER_API_KEY_ID=
ALPACA_PAPER_API_SECRET_KEY=
# LIVE keys belong ONLY in the Fly secret store for the production engine and api
# apps (R-3.1.c). Never set these locally, in CI, or in .mcp.json.
ALPACA_LIVE_API_KEY_ID=
ALPACA_LIVE_API_SECRET_KEY=
# sip | iex -- R-6.2.a requires sip. Blocked on open item O-1.
ALPACA_DATA_FEED=

# ---------------------------------------------------------------- database
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Never reaches the browser (R-16.4.b).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
OPERATOR_PHONE=
OPERATOR_EMAIL=

# ---------------------------------------------------------------- kill switch
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Single allowlisted chat. Bot tokens leak; this is the real control (R-13.6.b).
TELEGRAM_ALLOWED_CHAT_ID=
